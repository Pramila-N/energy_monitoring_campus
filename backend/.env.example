# Copy to backend/.env and fill real values:  (Windows) copy .env.example .env
# All credentials here are gitignored / never committed.

PORT=5000

# MongoDB connection string (local or Atlas). For Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_energy
MONGODB_URI=mongodb://localhost:27017/smart_energy
JWT_SECRET=change-this-super-secret-key-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Path to the Python ML module (relative to backend folder)
ML_DIR=../ml
ML_PREDICT_SCRIPT=scripts/predict.py
ML_PREDICT_OCCUPANCY_SCRIPT=scripts/predict_occupancy.py
ML_MODELS_DIR=models

# Simulation configuration
SIM_INTERVAL_MS=8000
SIM_MINUTES_PER_TICK=30
SIM_MAX_DAYS=14

# ---- Real Faculty Calling (Exotel) ----
# VOICE_PROVIDER=demo   -> simulated call lifecycle, safe for development/demos.
# VOICE_PROVIDER=exotel -> REAL outbound call via Exotel (requires EXOTEL_* vars below).
VOICE_PROVIDER=demo
EXOTEL_ACCOUNT_SID=
EXOTEL_API_TOKEN=
EXOTEL_FROM_NUMBER=
EXOTEL_CALLER_ID=
EXOTEL_PUBLIC_BASE_URL=
# Optional HTTP Basic Auth for the Exotel webhook endpoint (set BOTH, or leave empty).
CALLS_WEBHOOK_USER=
CALLS_WEBHOOK_PASS=

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api